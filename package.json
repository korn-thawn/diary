{
  "name": "diary",
  "version": "0.1.0",
  "private": true,
  "description": "Personal diary: React (Rspack + Tailwind) + Express + PostgreSQL",
  "main": "server/index.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,magenta \"node --watch server/index.js\" \"rspack serve\"",
    "build": "rspack build --mode production",
    "start": "node server/index.js",
    "migrate": "node server/migrate.js"
  },
  "dependencies": {
    "@fontsource/chakra-petch": "^5.3.0",
    "@fontsource/ibm-plex-sans-thai": "^5.3.0",
    "bcryptjs": "^3.0.3",
    "connect-pg-simple": "^10.0.0",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.2",
    "express-session": "^1.19.0",
    "helmet": "^8.3.0",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@heroicons/react": "^2.2.0",
    "@rspack/cli": "^2.3.0",
    "@rspack/core": "^2.3.0",
    "@rspack/dev-server": "^2.2.2",
    "@tailwindcss/postcss": "^4.3.3",
    "concurrently": "^10.0.6",
    "postcss": "^8.5.32",
    "postcss-loader": "^8.2.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^7.18.5",
    "tailwindcss": "^4.3.3"
  }
}

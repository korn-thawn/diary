# Copy to .env (never commit .env). On the server, /srv/apps/diary/.env is created there.
PORT=3101
# Local dev: podman/docker run -d --name pg -e POSTGRES_PASSWORD=dev -e POSTGRES_DB=diary -p 127.0.0.1:5432:5432 postgres:17
DATABASE_URL=postgres://postgres:dev@127.0.0.1:5432/diary
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me
# true only once the site is served over HTTPS
COOKIE_SECURE=false
# Open sign-up. Before HTTPS: test with throwaway passwords only.
ALLOW_REGISTER=true
